# ── WeKnora 服务 ──────────────────────
WEKNORA_BASE_URL=http://127.0.0.1:8080
# 在 WeKnora 后台创建的 API Key（Scope 需覆盖目标知识库）
WEKNORA_API_KEY=
# 客户端限流：入库与评测共用一个桶
WEKNORA_QPS=5

# ── 部署（deploy/docker-compose.zhitu.yml 使用）──
WEKNORA_VERSION=v0.9.0
WEKNORA_PORT=8080
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
DATABASE_URL=
VECTOR_STORE_TYPE=postgres
STORAGE_TYPE=local
CPU_LIMIT=2
MEM_LIMIT=4g
